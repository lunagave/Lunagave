[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/svg+xml;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;
Actions=PonerConLuna;AbrirLuna;
X-KDE-Priority=TopLevel

[Desktop Action PonerConLuna]
Name=Poner con Luna
Name[es]=Poner con Luna
Icon=luna
Exec=luna set %f

[Desktop Action AbrirLuna]
Name=Abrir Luna
Name[es]=Abrir Luna
Icon=luna
Exec=luna-gui
